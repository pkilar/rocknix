[Unit]
Description=Recover rk915 WiFi if the boot-time probe lost the RX race
After=multi-user.target
Wants=multi-user.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'sleep 30; if ip route | grep -q "^default"; then logger -t rk915-recover "link OK, no action"; exit 0; fi; logger -t rk915-recover "no default route - reloading rk915"; modprobe -r rk915; sleep 3; modprobe rk915; sleep 10; systemctl restart iwd; sleep 20; ip route | grep -q "^default" && logger -t rk915-recover "recovered" || logger -t rk915-recover "still down"'

[Install]
WantedBy=multi-user.target
