mmc: dw_mmc: stop a TXDR/RXDR interrupt storm when there is nothing to service

TXDR and RXDR mean "the FIFO wants servicing". The handler clears the latch in
RINTSTS and then only acts if a transfer is actually in flight:

	if (pending & SDMMC_INT_TXDR) {
		mci_writel(host, RINTSTS, SDMMC_INT_TXDR);
		if (host->dir_status == MMC_DATA_WRITE && host->sg)
			dw_mci_write_data_pio(host);
	}

If host->sg is NULL the FIFO is not fed, the underlying condition persists, and
the hardware re-asserts immediately. Clearing the latch achieves nothing.

This happens when a card dies part-way through a CMD53 write: the controller
still wants data, the driver has none left to give, and because TMOUT is
programmed to 0xFFFFFFFF the data timeout never fires to abort the transfer.
The result is an interrupt storm. Captured on a Gusgu H7 (RK3326) with the RK915
sdio wifi chip, by dumping the controller state every 200000th interrupt:

    DWDIAG MINTSTS=00000010 INTMASK=0100b7ff RINTSTS=00010010 STATUS=00ffaf02
           IDSTS=00000000 dir=256 sg=0 state=1 cmd=53

MINTSTS 0x10 is TXDR, dir 256 is MMC_DATA_WRITE, sg=0, cmd 53. Measured with
per-irq tracing at ~684,000 interrupts/second:

    IRQTRACE 344 dwmci: 56:164736147  vop=11531 adc=24734 ser=418 gpio=10946
    IRQTRACE 345 dwmci: 56:165433415  vop=11531 adc=24734 ser=418 gpio=10946

Every other interrupt on that CPU is frozen at a fixed count. All device
interrupts on this board are affine to CPU0, so the VOP stops (drm vblank
timeouts), the SARADC stops (joypad error spam) and the network dies - the
machine has to be power cycled. The RCU stall it produces reports the CPU in
default_idle_call(), which looks like an idle CPU but is not: it is being
re-interrupted between every WFI. That misdirection cost several rounds of this
investigation - cpuidle.off=1 and nohz=off were both tried and changed nothing.

Mask the offending bit when there is no transfer to service, and re-arm both
bits in dw_mci_submit_data() for the next transfer.

Also included: dw_mci_wait_while_busy() and dw_mci_interrupt() treat an all-ones
read from an absent controller as meaningful; bail out instead. Those were found
first and are kept, though neither turned out to be this storm.

--- a/drivers/mmc/host/dw_mmc.c	2026-08-27 17:27:10.451821644 -0400
+++ b/drivers/mmc/host/dw_mmc.c	2026-08-27 17:27:10.452768603 -0400
@@ -213,11 +213,26 @@
 	 */
 	if ((cmd_flags & SDMMC_CMD_PRV_DAT_WAIT) &&
 	    !(cmd_flags & SDMMC_CMD_VOLT_SWITCH)) {
+		/*
+		 * An all-ones read means the controller is not answering at all
+		 * - unclocked, powered down, or the card has fallen off the bus
+		 * - it does not mean "busy". Treating it as busy makes this
+		 * atomic poll burn its full 500ms with host->lock held and
+		 * interrupts disabled, and a caller that keeps retrying then
+		 * pins the CPU: interrupts stop being serviced, RCU stalls, and
+		 * the machine wedges hard enough that printk stops coming out.
+		 * Break out instead and let the command time out normally, so
+		 * the error reaches the driver and its recovery path can run.
+		 */
 		if (readl_poll_timeout_atomic(host->regs + SDMMC_STATUS,
 					      status,
+					      status == ~0U ||
 					      !(status & SDMMC_STATUS_BUSY),
 					      10, 500 * USEC_PER_MSEC))
 			dev_err(host->dev, "Busy; trying anyway\n");
+		else if (status == ~0U)
+			dev_err_ratelimited(host->dev,
+					    "host not responding (status=~0)\n");
 	}
 }
 
@@ -1056,10 +1071,20 @@
 
 static void dw_mci_submit_data(struct dw_mci *host, struct mmc_data *data)
 {
+	unsigned long dw_irqflags;
+	u32 dw_int_mask;
+
 	unsigned long irqflags;
 	int flags = SG_MITER_ATOMIC;
 	u32 temp;
 
+	/* re-arm the fifo irqs in case a stuck one was masked previously */
+	spin_lock_irqsave(&host->irq_lock, dw_irqflags);
+	dw_int_mask = mci_readl(host, INTMASK);
+	mci_writel(host, INTMASK,
+		   dw_int_mask | SDMMC_INT_TXDR | SDMMC_INT_RXDR);
+	spin_unlock_irqrestore(&host->irq_lock, dw_irqflags);
+
 	data->error = -EINPROGRESS;
 
 	WARN_ON(host->data);
@@ -1554,6 +1579,32 @@
 	}
 }
 
+/*
+ * TXDR/RXDR signal that the FIFO wants servicing. The handler clears the latch,
+ * but if there is no transfer left to service (host->sg == NULL) the underlying
+ * FIFO condition persists and the hardware re-asserts immediately. If the card
+ * dies mid-transfer - and TMOUT is programmed to its maximum, so the data
+ * timeout will not rescue us - that becomes an interrupt storm: measured at
+ * ~684,000/s on an RK3326, which starves every other interrupt on the CPU and
+ * hangs the machine. Mask the offending bit; dw_mci_submit_data() re-arms it for
+ * the next transfer.
+ */
+static void dw_mci_mask_stuck_fifo_irq(struct dw_mci *host, u32 bit)
+{
+	unsigned long irqflags;
+	u32 int_mask;
+
+	spin_lock_irqsave(&host->irq_lock, irqflags);
+	int_mask = mci_readl(host, INTMASK);
+	if (int_mask & bit) {
+		mci_writel(host, INTMASK, int_mask & ~bit);
+		dev_err_ratelimited(host->dev,
+				    "FIFO irq %#x with no transfer to service; masking\n",
+				    bit);
+	}
+	spin_unlock_irqrestore(&host->irq_lock, irqflags);
+}
+
 static void __dw_mci_enable_sdio_irq(struct dw_mci *host, int enb)
 {
 	unsigned long irqflags;
@@ -2674,6 +2725,45 @@
 
 	pending = mci_readl(host, MINTSTS); /* read-only mask reg */
 
+	/*
+	 * DIAGNOSTIC (temporary): during an interrupt storm, dump the register
+	 * state every 200000th interrupt. At ~684k/s that is ~3 lines a second;
+	 * in normal operation it essentially never fires.
+	 */
+	{
+		static unsigned long dwdiag_n;
+
+		if (pending && (++dwdiag_n % 200000 == 0))
+			pr_err("DWDIAG MINTSTS=%08x INTMASK=%08x RINTSTS=%08x STATUS=%08x IDSTS=%08x dir=%d sg=%d state=%d cmd=%d\n",
+			       pending,
+			       mci_readl(host, INTMASK),
+			       mci_readl(host, RINTSTS),
+			       mci_readl(host, STATUS),
+			       mci_readl(host, IDSTS),
+			       host->dir_status,
+			       host->sg ? 1 : 0,
+			       host->state,
+			       host->cmd ? host->cmd->opcode : -1);
+	}
+
+	/*
+	 * An all-ones read means the controller is not answering - unclocked,
+	 * powered down, or the card fell off the bus - not that every interrupt
+	 * is pending. Servicing it "handles" all 32 bits, the writes to RINTSTS
+	 * go nowhere, and because the line is level triggered we are re-entered
+	 * immediately: a ~690k/s storm that starves every other interrupt on the
+	 * CPU. On a Gusgu H7 that stops the VOP (vblank timeouts), the SARADC
+	 * (joypad error spam) and the network, and RCU stalls because the CPU is
+	 * permanently in irq context entered from idle - the machine appears to
+	 * hang. Return IRQ_NONE so the spurious-irq machinery can shut the line
+	 * down instead of the CPU spinning on it forever.
+	 */
+	if (pending == ~0U) {
+		dev_err_ratelimited(host->dev,
+				    "host not responding, MINTSTS=~0; ignoring\n");
+		return IRQ_NONE;
+	}
+
 	if (pending) {
 		/* Check volt switch first, since it can look like an error */
 		if ((host->state == STATE_SENDING_CMD11) &&
@@ -2749,12 +2839,16 @@
 			mci_writel(host, RINTSTS, SDMMC_INT_RXDR);
 			if (host->dir_status == MMC_DATA_READ && host->sg)
 				dw_mci_read_data_pio(host, false);
+			else
+				dw_mci_mask_stuck_fifo_irq(host, SDMMC_INT_RXDR);
 		}
 
 		if (pending & SDMMC_INT_TXDR) {
 			mci_writel(host, RINTSTS, SDMMC_INT_TXDR);
 			if (host->dir_status == MMC_DATA_WRITE && host->sg)
 				dw_mci_write_data_pio(host);
+			else
+				dw_mci_mask_stuck_fifo_irq(host, SDMMC_INT_TXDR);
 		}
 
 		if (pending & SDMMC_INT_CMD_DONE) {
@@ -2783,6 +2877,18 @@
 	if (host->use_dma != TRANS_MODE_IDMAC)
 		return IRQ_HANDLED;
 
+	/*
+	 * Abnormal IDMAC conditions - fatal bus error, descriptor unavailable,
+	 * card error summary - are latched but were never acknowledged here,
+	 * only TI/RI/NI were. If the card drops off the bus mid-DMA the IDMAC
+	 * raises FBE/DU/CES (and the AI summary), nothing clears them, and the
+	 * level-triggered line stays asserted: the handler is re-entered
+	 * forever. Measured at ~684,000 interrupts/second on an RK3326, which
+	 * starves every other interrupt on that CPU and hangs the machine.
+	 */
+#define DW_MCI_IDMAC_ABNORMAL	(SDMMC_IDMAC_INT_FBE | SDMMC_IDMAC_INT_DU | \
+				 SDMMC_IDMAC_INT_CES | SDMMC_IDMAC_INT_AI)
+
 	/* Handle IDMA interrupts */
 	if (host->dma_64bit_address == 1) {
 		pending = mci_readl(host, IDSTS64);
@@ -2793,6 +2899,12 @@
 			if (!test_bit(EVENT_DATA_ERROR, &host->pending_events))
 				host->dma_ops->complete((void *)host);
 		}
+		if (pending & DW_MCI_IDMAC_ABNORMAL) {
+			mci_writel(host, IDSTS64, DW_MCI_IDMAC_ABNORMAL);
+			dev_err_ratelimited(host->dev,
+					    "IDMAC abnormal, IDSTS64=%08x\n",
+					    pending);
+		}
 	} else {
 		pending = mci_readl(host, IDSTS);
 		if (pending & (SDMMC_IDMAC_INT_TI | SDMMC_IDMAC_INT_RI)) {
@@ -2802,6 +2914,12 @@
 			if (!test_bit(EVENT_DATA_ERROR, &host->pending_events))
 				host->dma_ops->complete((void *)host);
 		}
+		if (pending & DW_MCI_IDMAC_ABNORMAL) {
+			mci_writel(host, IDSTS, DW_MCI_IDMAC_ABNORMAL);
+			dev_err_ratelimited(host->dev,
+					    "IDMAC abnormal, IDSTS=%08x\n",
+					    pending);
+		}
 	}
 
 	return IRQ_HANDLED;
