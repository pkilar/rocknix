+/*
+ * TXDR/RXDR signal that the FIFO wants servicing. The handler clears the latch,
+ * but if there is no transfer left to service (host->sg == NULL) the underlying
+ * FIFO condition persists and the hardware re-asserts immediately. If the card
+ * dies mid-transfer - and TMOUT is programmed to its maximum, so the data
+ * timeout will not rescue us - that becomes an interrupt storm: measured at
+ * ~684,000/s on an RK3326, which starves every other interrupt on the CPU and
+ * hangs the machine. Mask the offending bit; dw_mci_submit_data() re-arms it for
+ * the next transfer.
+ */
+static void dw_mci_mask_stuck_fifo_irq(struct dw_mci *host, u32 bit)
+{
+	unsigned long irqflags;
+	u32 int_mask;
+
+	spin_lock_irqsave(&host->irq_lock, irqflags);
+	int_mask = mci_readl(host, INTMASK);
+	if (int_mask & bit) {
+		mci_writel(host, INTMASK, int_mask & ~bit);
+		dev_err_ratelimited(host->dev,
+				    "FIFO irq %#x with no transfer to service; masking\n",
+				    bit);
+	}
+	spin_unlock_irqrestore(&host->irq_lock, irqflags);
+}
